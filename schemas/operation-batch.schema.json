{
 "$schema":"https://json-schema.org/draft/2020-12/schema", "type":"object", "additionalProperties":false,
 "required":["schema_version","input_sha256","mode","operations"],
 "properties":{
  "schema_version":{"const":1}, "input_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "mode":{"enum":["free_edit","locked_template"]},
  "operations":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
   "required":["id","module","action","target"],"properties":{
    "id":{"type":"string","minLength":1}, "module":{"type":"string","pattern":"^M(0[1-9]|1[0-9]|20)$"},
    "action":{"enum":["add","set","remove","get","extension"]}, "target":{"type":"string","minLength":1},
    "kind":{"type":"string"}, "props":{"type":"object","additionalProperties":{"type":["string","number","boolean","array","object","null"]}}
   }}}
 }
}
